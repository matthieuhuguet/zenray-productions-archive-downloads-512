  plugins: [react(), tailwindcss()],
})
```

## 2. Protocole Design "ZenRay Icon"
L'architecture visuelle suit une hiérarchie de calques stricte pour garantir un export propre (détouré) :

1.  **Container Global** : `bg-transparent` (Invisible, sert uniquement au centrage).
2.  **Shape (Le support)** : Carré Noir à bords arrondis (`rounded-[25%]`, `aspect-square`).
3.  **Content (L'info)** : Typographie Jaune (`#f9f757`) centrée, sans fioritures.

## 3. Template "Code Frugal" (Export Ready)
Ce composant contient toute la logique nécessaire : Rendu + Export PNG 4K sur touche 'E'.

```tsx
import { toPng } from 'html-to-image';
import { useEffect, useRef } from 'react';

export const IconGenerator = () => {
  const ref = useRef<HTMLDivElement>(null);

  useEffect(() => {
    const handleKeyDown = async (e: KeyboardEvent) => {
      if (e.key.toLowerCase() === 'e' && ref.current) {
        // Export PNG 4K avec transparence préservée
        const dataUrl = await toPng(ref.current, { 
          pixelRatio: 3, 
          backgroundColor: null // Force la transparence
        });
        const link = document.createElement('a');
        link.download = 'icon-export.png';
        link.href = dataUrl;
        link.click();
      }
    };
    window.addEventListener('keydown', handleKeyDown);
    return () => window.removeEventListener('keydown', handleKeyDown);
  }, []);

  return (
    // 1. Fond Transparent (Viewport)
    <div className="flex h-screen w-full items-center justify-center bg-transparent">
      
      {/* 2. Shape (Zone capturée par la ref) */}
      <div 
        ref={ref}
        className="flex aspect-square w-[500px] items-center justify-center rounded-[25%] bg-black"
      >
        {/* 3. Content */}
        <h1 className="font-primary text-[120px] leading-none tracking-tighter uppercase text-[#f9f757] select-none">
          MEDIA
        </h1>
      </div>

    </div>
  );
};
```

